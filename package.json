{
  "name": "@andriilavrekha/breadcrumbs",
  "version": "0.7.0",
  "description": "Breadcrumbs: resumable project-local Markdown memory for coding agents.",
  "homepage": "https://github.com/AndriiLavrekha/breadcrumbs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndriiLavrekha/breadcrumbs.git"
  },
  "bugs": {
    "url": "https://github.com/AndriiLavrekha/breadcrumbs/issues"
  },
  "license": "MIT",
  "private": false,
  "type": "module",
  "bin": {
    "breadcrumbs": "dist/src/cli.js",
    "awesome-progress-tracker": "dist/src/cli.js",
    "project-progress": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "templates/project-progress",
    "agent-instructions",
    "skills/project-progress",
    ".codex-plugin",
    ".agents/plugins",
    ".mcp.json",
    ".mcp.codex.json",
    "hooks",
    "TESTING.md",
    "README.md",
    "RELEASE_CHECKLIST.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:mcp": "vitest run tests/mcp",
    "typecheck": "tsc -p tsconfig.test.json",
    "bench:build": "tsc -p bench/tsconfig.json",
    "bench": "npm run bench:build && node bench/dist/harness/cli.js",
    "build": "tsc -p tsconfig.json",
    "build:mcp": "tsc -p tsconfig.json",
    "mcp": "node dist/src/mcp/server.js",
    "hook": "node dist/src/hook/cli.js",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
